        {
            "src": "assets/img/screenshots/main-screen.png",
            "sizes": "1280x720",
            "type": "image/png",
            "form_factor": "wide",
            "label": "Main Interface"
        },
        {
            "src": "assets/img/screenshots/voice-screen.png",
            "sizes": "1280x720",
            "type": "image/png",
            "form_factor": "wide",
            "label": "Voice Recognition"
        }
    ],
    "shortcuts": [
        {
            "name": "Voice Command",
            "short_name": "Voice",
            "description": "Start voice command",
            "url": "/index.html?action=voice",
            "icons": [
                {
                    "src": "assets/img/icons/voice-icon.png",
                    "sizes": "192x192"
                }
            ]
        },
        {
            "name": "Settings",
            "short_name": "Settings",
            "description": "Open settings",
            "url": "/index.html?action=settings",
            "icons": [
                {
                    "src": "assets/img/icons/settings-icon.png",
                    "sizes": "192x192"
                }
            ]
        }
    ],
    "related_applications": [],
    "prefer_related_applications": false,
    "display_override": [
        "window-controls-overlay",
        "standalone",
        "browser"
    ],
    "edge_side_panel": {
        "preferred_width": 400
    },
    "protocol_handlers": [
        {
            "protocol": "web+jarvis",
            "url": "/index.html?command=%s"
        }
    ],
    "share_target": {
        "action": "/share",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    }
}